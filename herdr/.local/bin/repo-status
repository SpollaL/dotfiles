#!/usr/bin/env bash
# Interactive git + GitHub dashboard for a tree of sibling repositories.
#
# Rows are your open PRs, open PRs you are a reviewer on, and the repos
# themselves.
# Enter opens a row on github.com, ctrl-o opens its repo in a new herdr tab,
# ctrl-u fast-forwards that repo's checked-out branch — which is the local
# branch, not the row's PR branch, on every row type.
# Scope is whatever is checked out under ROOT, so PRs in repos you do not have
# locally stay out of the way.
set -euo pipefail

export PATH="$HOME/.fzf/bin:$HOME/.local/bin:$PATH"

# Column widths, shared by the bash and jq row builders so the three row types
# line up in the picker.
W_REPO=28 W_NUM=6 W_CI=6 W_DEC=14 W_AGE=4 W_STATE=9 W_WHO=20

# Fixed-width cell. Long branch and repo names are common enough that letting
# one overflow would shift every column to its right.
cell() {
  local s=$1 w=$2
  ((${#s} > w)) && s="${s:0:w-1}~"
  printf '%-*s' "$w" "$s"
}

# owner/name from a remote URL, for both the ssh and https forms.
name_with_owner() {
  sed -E 's#\.git$##; s#^.*[:/]([^:/]+/[^:/]+)$#\1#' <<<"$1"
}

# Every repo in the tree — ROOT itself plus its immediate children — as
# "<dir>\t<owner/name>". Directories without an origin remote are skipped.
repos() {
  local root=$1 dir url
  for dir in "$root" "$root"/*/; do
    dir=${dir%/}
    [[ -d $dir/.git ]] || continue
    url=$(git -C "$dir" remote get-url origin 2>/dev/null) || continue
    printf '%s\t%s\n' "$dir" "$(name_with_owner "$url")"
  done
}

# Refresh remote-tracking refs without making the picker wait on one SSH
# round-trip per repo. Counts converge by the time you hit ctrl-r.
background_fetch() {
  local dir
  while IFS=$'\t' read -r dir _; do
    (git -C "$dir" fetch --quiet --all --prune >/dev/null 2>&1 &)
  done
}

# REPO rows: current branch, uncommitted files, and drift from the upstream as
# of the last fetch.
local_rows() {
  local dir nwo branch dirty counts behind ahead state drift
  while IFS=$'\t' read -r dir nwo; do
    branch=$(git -C "$dir" branch --show-current)
    [[ -n $branch ]] || branch='(detached)'
    dirty=$(git -C "$dir" status --porcelain | wc -l)

    if [[ $dirty -gt 0 ]]; then
      state=$(printf '\033[33m%s\033[0m' "$(cell "$dirty dirty" "$W_STATE")")
    else
      state=$(printf '\033[90m%s\033[0m' "$(cell clean "$W_STATE")")
    fi

    drift=""
    if counts=$(git -C "$dir" rev-list --left-right --count '@{upstream}...HEAD' 2>/dev/null); then
      read -r behind ahead <<<"$counts"
      [[ $ahead -gt 0 ]] && drift+=$(printf '\033[32m%s ahead\033[0m ' "$ahead")
      [[ $behind -gt 0 ]] && drift+=$(printf '\033[31m%s behind\033[0m' "$behind")
      [[ -n $drift ]] || drift=$(printf '\033[90min sync\033[0m')
    else
      drift=$(printf '\033[90mno upstream\033[0m')
    fi

    printf '%s\t%s\t%s\t%s %s %s %s %s\n' \
      REPO "$dir" "https://github.com/$nwo" \
      "$(printf '\033[90m%-4s\033[0m' REPO)" \
      "$(cell "${nwo##*/}" "$W_REPO")" \
      "$(printf '\033[36m%s\033[0m' "$(cell "$branch" $((W_NUM + W_CI + W_DEC + 2)))")" \
      "$state" "$drift"
  done
}

read -r -d '' GQL <<'EOF' || true
query($mine: String!, $requested: String!, $reviewed: String!) {
  viewer { login }
  mine: search(query: $mine, type: ISSUE, first: 100) {
    nodes { ... on PullRequest { ...prBits reviewDecision } }
  }
  requested: search(query: $requested, type: ISSUE, first: 100) {
    nodes { ... on PullRequest { ...prBits } }
  }
  reviewed: search(query: $reviewed, type: ISSUE, first: 100) {
    nodes { ... on PullRequest { ...prBits } }
  }
}
fragment prBits on PullRequest {
  number title url isDraft createdAt mergeable
  repository { name }
  author { login }
  commits(last: 1) { nodes { commit { statusCheckRollup { state } } } }
  latestReviews(first: 20) { nodes { author { login __typename } state } }
  # A review left as a plain conversation comment is not a Review: it reaches
  # neither latestReviews nor reviewed-by:@me, and search's commenter:
  # qualifier does not find it either, so the comment list is the only
  # evidence it exists.
  # ponytail: last 50 comments; raise it if a thread ever buries your own.
  comments(last: 50) { nodes { author { login __typename } } }
}
EOF

read -r -d '' JQ <<'EOF' || true
def pad($n): (. // "") | . + (" " * ([$n - length, 0] | max) // "");
def cell($n): (. // "") | (if length > $n then .[0:$n - 1] + "~" else . end) | pad($n);
def paint($c): "\u001b[\($c)m\(.)\u001b[0m";
def age: (now - fromdateiso8601) as $s
  | if $s < 3600 then "\(($s / 60) | floor)m"
    elif $s < 86400 then "\(($s / 3600) | floor)h"
    elif $s < 604800 then "\(($s / 86400) | floor)d"
    else "\(($s / 604800) | floor)w" end;
def ci_mark:
  if . == "SUCCESS" then ("pass" | pad($ci) | paint(32))
  elif . == "FAILURE" or . == "ERROR" then ("FAIL" | pad($ci) | paint(31))
  elif . == "PENDING" then ("run" | pad($ci) | paint(33))
  else ("no ci" | pad($ci) | paint(90)) end;
# REVIEW column on a PR row: where the PR as a whole stands. Copilot only leaves
# COMMENTED reviews and those never move reviewDecision, so a PR nothing but the
# bot has read still lands in the pending branch. REVIEW_REQUIRED and a null
# decision say the same thing here — no human verdict yet — so they share a label.
def dec_mark:
  if . == "APPROVED" then ("approved" | pad($dec) | paint(32))
  elif . == "CHANGES_REQUESTED" then ("CHANGES" | pad($dec) | paint(31))
  elif . == "COMMENTED" then ("commented" | pad($dec) | paint(36))
  else ("pending review" | pad($dec) | paint(90)) end;
# REVIEW column on a REV row: where *you* stand. GitHub drops the review request
# the moment you submit, so anything past "requested" would otherwise vanish from
# the board while the PR is still open and still yours to follow.
# Only your own reviews and comments reach this; a PR Copilot alone has been
# over falls to PENDING, which is yellow like "requested" because both mean you
# still owe it.
def my_mark:
  if . == "REQUESTED" then ("requested" | pad($dec) | paint(93))
  elif . == "APPROVED" then ("approved" | pad($dec) | paint(32))
  elif . == "CHANGES_REQUESTED" then ("CHANGES" | pad($dec) | paint(31))
  elif . == "COMMENTED" then ("commented" | pad($dec) | paint(36))
  else ("pending review" | pad($dec) | paint(93)) end;
def flags:
  [ (if .isDraft then ("draft" | paint(90)) else empty end),
    (if .mergeable == "CONFLICTING" then ("CONFLICT" | paint(31)) else empty end)
  ] | join(" ");
def ci_cell: ((.commits.nodes[0].commit.statusCheckRollup.state // "") | ci_mark);
def key: "\(.repository.name)#\(.number)";
def rev_row($state):
  [ "REV", ($dirs[.repository.name] // ""), .url,
    ( ("REV" | pad(4) | paint(33)) + " "
      + (.repository.name | cell($repo)) + " "
      + ("#\(.number)" | pad($num) | paint(90)) + " "
      + ci_cell + " "
      + ($state | my_mark) + " "
      + (.createdAt | age | pad($agew) | paint(90)) + " "
      + ((.author.login // "?") | cell($who) | paint(36)) + " "
      + .title + " " + flags )
  ] | @tsv;

.data as $d
| $d.viewer.login as $me
| ([$d.requested.nodes[] | key] | map({(.): true}) | add // {}) as $pending
# Your standing on a PR: your own latest review, then a plain conversation
# comment from you, then $default. Without the comment step a PR you have
# written a full review into by hand still reads as untouched.
# Where your own PR stands. reviewDecision only ever reports approved, changes
# requested, or nothing, so someone working through your PR in comments is
# invisible in it — and that is most of the life of a PR under review. Bots are
# excluded: Copilot reviews every PR the moment it opens, which would mark every
# row commented and tell you nothing.
| def pr_state:
    (.reviewDecision // "") as $decision
    | if $decision == "APPROVED" or $decision == "CHANGES_REQUESTED" then $decision
      elif any((.latestReviews.nodes[]?, .comments.nodes[]?);
               .author.__typename != "Bot" and .author.login != $me)
      then "COMMENTED"
      else $decision end;
  def my_state($default):
    ([.latestReviews.nodes[]? | select(.author.login == $me) | .state] | first) as $verdict
    | $verdict // (if any(.comments.nodes[]?; .author.login == $me)
                   then "COMMENTED" else $default end);
  (
  ( $d.mine.nodes[]
    | [ "PR", ($dirs[.repository.name] // ""), .url,
        ( ("PR" | pad(4) | paint(35)) + " "
          + (.repository.name | cell($repo)) + " "
          + ("#\(.number)" | pad($num) | paint(90)) + " "
          + ci_cell + " "
          + (pr_state | dec_mark) + " "
          + (.createdAt | age | pad($agew) | paint(90)) + " "
          + .title + " " + flags )
      ] | @tsv
  ),
  ( $d.requested.nodes[] | rev_row(my_state("REQUESTED")) ),
  # Your own PRs land in reviewed-by:@me as soon as you comment on one, but they
  # are already PR rows above, so REV stays other people's work.
  ( $d.reviewed.nodes[]
    | select(.author.login != $me and ($pending[key] | not))
    | rev_row(my_state("PENDING"))
  )
)
EOF

# PR and REV rows: one GraphQL call, scoped to exactly the repos on disk so a
# PR in a repo you have not checked out here never shows up.
remote_rows() {
  local scope="" dirs="{}" dir nwo
  while IFS=$'\t' read -r dir nwo; do
    scope+=" repo:$nwo"
    dirs=$(jq -c --arg n "${nwo##*/}" --arg d "$dir" '. + {($n): $d}' <<<"$dirs")
  done

  gh api graphql -f query="$GQL" \
    -f mine="is:pr is:open author:@me$scope" \
    -f requested="is:pr is:open review-requested:@me$scope" \
    -f reviewed="is:pr is:open reviewed-by:@me$scope" |
    jq -r --argjson dirs "$dirs" \
      --argjson repo "$W_REPO" --argjson num "$W_NUM" --argjson ci "$W_CI" \
      --argjson dec "$W_DEC" --argjson agew "$W_AGE" --argjson who "$W_WHO" "$JQ"
}

# All rows as "<type>\t<dir>\t<url>\t<display>". Also the ctrl-r reload target,
# which is why it is a mode rather than a plain function call.
#
# PR state comes back live, but the fetch it kicks off lands after these rows
# are built, so drift counts are always one refresh behind.
emit_rows() {
  local root=$1 list
  list=$(repos "$root")
  background_fetch <<<"$list"
  remote_rows <<<"$list"
  local_rows <<<"$list"
}

case ${1-} in
  --rows)
    emit_rows "${2:?--rows needs a root directory}"
    exit 0
    ;;
  --open)
    exec "${BROWSER:-xdg-open}" "${2:?--open needs a url}"
    ;;
  --tab)
    exec herdr tab create --cwd "${2:?--tab needs a directory}" \
      --label "$(basename "$2")" --focus
    ;;
  --selftest)
    # The REVIEW cell is a ladder on both row types — on a REV row your own
    # review, then a plain comment from you; on a PR row the decision, then any
    # human comment — and it has been wrong in both directions before. One
    # fixture through the real jq program.
    read -r -d '' FIXTURE <<'JSON' || true
{ "data": { "viewer": { "login": "me" }, "reviewed": { "nodes": [] },
  "mine": { "nodes": [
    { "number": 4, "reviewDecision": "APPROVED", "author": { "login": "me" },
      "latestReviews": { "nodes": [] }, "comments": { "nodes": [] },
      "title": "a verdict outranks any comment" },
    { "number": 5, "reviewDecision": "REVIEW_REQUIRED", "author": { "login": "me" },
      "latestReviews": { "nodes": [] },
      "comments": { "nodes": [{ "author": { "login": "them", "__typename": "User" } }] },
      "title": "a human comment shows on your own PR" },
    { "number": 6, "reviewDecision": "REVIEW_REQUIRED", "author": { "login": "me" },
      "latestReviews": { "nodes": [{ "author": { "login": "bot", "__typename": "Bot" }, "state": "COMMENTED" }] },
      "comments": { "nodes": [{ "author": { "login": "me", "__typename": "User" } }] },
      "title": "a bot, or you alone, does not" } ] },
  "requested": { "nodes": [
    { "number": 1, "latestReviews": { "nodes": [{ "author": { "login": "me" }, "state": "APPROVED" }] },
      "comments": { "nodes": [] }, "title": "my own review wins" },
    { "number": 2, "latestReviews": { "nodes": [{ "author": { "login": "bot" }, "state": "COMMENTED" }] },
      "comments": { "nodes": [{ "author": { "login": "me" } }] }, "title": "a plain comment counts" },
    { "number": 3, "latestReviews": { "nodes": [] },
      "comments": { "nodes": [{ "author": { "login": "other" } }] }, "title": "someone else commenting does not" } ] } } }
JSON
    got=$(jq 'def fill: { url: "u", isDraft: false, createdAt: "2020-01-01T00:00:00Z",
          mergeable: "MERGEABLE", repository: { name: "r" },
          author: { login: "other" }, commits: { nodes: [] } } + .;
        .data.mine.nodes[] |= fill | .data.requested.nodes[] |= fill' <<<"$FIXTURE" |
      jq -r --argjson dirs '{}' --argjson repo "$W_REPO" --argjson num "$W_NUM" \
        --argjson ci "$W_CI" --argjson dec "$W_DEC" --argjson agew "$W_AGE" \
        --argjson who "$W_WHO" "$JQ" |
      sed -e 's/\x1b\[[0-9;]*m//g' -e 's/  */ /g')
    rc=0
    while read -r want; do
      grep -qF "$want" <<<"$got" || { printf 'selftest: no row reads "%s"\n' "$want" >&2; rc=1; }
    done <<'CASES'
#1 no ci approved
#2 no ci commented
#3 no ci requested
#4 no ci approved
#5 no ci commented
#6 no ci pending review
CASES
    ((rc == 0)) && echo 'selftest: ok'
    exit $rc
    ;;
  --pull)
    # Fast-forward only. A diverged branch or a dirty tree needs a decision
    # that a single keystroke in a picker should not be making, so let git
    # refuse and show why rather than reaching for pull or a rebase.
    dir=${2:?--pull needs a directory}
    if out=$(git -C "$dir" fetch --quiet 2>&1 &&
      git -C "$dir" merge --ff-only '@{upstream}' 2>&1); then
      exit 0
    fi
    printf '%s: %s\n' "$(basename "$dir")" "$out" >&2
    read -rsn1 -p 'press any key' || true
    exit 0
    ;;
esac

ROOT=$(cd "${1:-$PWD}" && pwd)
SELF=$(realpath "$0")

# Keys, what each row type means, and column titles positioned with the same
# widths the rows use. The titles describe PR rows; a REV row inserts its author
# ahead of the title, and a REPO row spends the PR#/CI/REVIEW span on its branch
# and the AGE/TITLE span on tree and drift.
read -r -d '' HEADER <<EOF || true
enter open on GitHub    ctrl-u fast-forward    ctrl-o repo in new tab    ctrl-r refresh
PR yours    REV you are a reviewer, REVIEW is your own verdict    REPO local checkout
$(printf '%-4s %-*s %-*s %-*s %-*s %-*s %s' \
  TYPE "$W_REPO" REPO "$W_NUM" PR# "$W_CI" CI "$W_DEC" REVIEW "$W_AGE" AGE \
  'TITLE  (REV: author first; REPO: branch, working tree, drift)')
EOF

emit_rows "$ROOT" | fzf \
  --ansi \
  --delimiter=$'\t' \
  --with-nth=4.. \
  --no-sort \
  --reverse \
  --border \
  --prompt='repo-status > ' \
  --header="$HEADER" \
  --bind "enter:execute-silent($SELF --open {3})" \
  --bind "ctrl-o:execute-silent($SELF --tab {2})+abort" \
  --bind "ctrl-u:execute($SELF --pull {2})+reload($SELF --rows $ROOT)" \
  --bind "ctrl-r:reload($SELF --rows $ROOT)"
